{
    "$schema": "./node_modules/@cngxjs/compodocx/src/config/schema.json",
    "tsconfig": "./tsconfig.doc.json",
    "name": "cngx",
    "output": "./docs",
    "theme": "./cngx-compodocx-theme.css",
    "customFavicon": "./brand/favicon.svg",
    "shikiTheme": "github-light:github-dark",
    "multiVersion": false,
    "includes": "core-concepts",
    "includesName": "Core Concepts",
    "assetsFolder": "brand",
    "disableSourceCode": true,
    "disableTemplateTab": true,
    "disableStyleTab": true,
    "disablePrivate": true,
    "disableInternal": true,
    "disableRoutes": true,
    "disableDomTree": true,
    "disableGraph": false,
    "disableDependenciesTab": true,
    "disableDependencies": true,
    "disableProperties": true,
    "menuLayout": "feature",
    "featuresName": "Libraries",
    "collapsedAll": true,
    "classificationAxes": {
        "level": {
            "label": "Level",
            "values": [
                "atom",
                "molecule",
                "organism"
            ],
            "kinds": [
                "component",
                "directive"
            ]
        }
    },
    "showEffects": false,
    "apiTabSections": [
        "index",
        "inputs",
        "outputs",
        "properties",
        "methods",
        "accessors",
        "indexSignatures",
        "hostBindings",
        "hostListeners"
    ],
    "themingTabSections": [
        "overview",
        "index",
        "tokens"
    ],
    "navTabConfig": [
        {
            "id": "readme",
            "label": "UX / A11Y Principles"
        },
        {
            "id": "info",
            "label": "Info"
        },
        {
            "id": "api",
            "label": "API"
        },
        {
            "id": "theming",
            "label": "Theming"
        },
        {
            "id": "example",
            "label": "Example"
        },
        {
            "id": "playground",
            "label": "Playground"
        }
    ],
    "playgroundDependencies": {
        "@cngx/utils": "0.1.0-rc.8",
        "@cngx/core": "0.1.0-rc.8",
        "@cngx/common": "0.1.0-rc.8",
        "@cngx/forms": "0.1.0-rc.8",
        "@cngx/ui": "0.1.0-rc.8",
        "@cngx/data-display": "0.1.0-rc.8",
        "@cngx/interop": "0.1.0-rc.8",
        "@cngx/themes": "0.1.0-rc.8",
        "@angular/material": "^21.2.2",
        "libphonenumber-js": "^1.11.0"
    },
    "playgroundGlobalStyles": "@import '@cngx/themes/cngx.css';",
    "playgroundMaterialShell": true
}