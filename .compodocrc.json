{
    "$schema": "./node_modules/@cngxjs/compodocx/src/config/schema.json",
    "tsconfig": "./tsconfig.doc.json",
    "name": "cngx",
    "output": "./docs",
    "theme": "./cngx-compodocx-theme.css",
    "customFavicon": "./brand/favicon.svg",
    "customLogo": "./brand/cngx-lockup-full-on-light.svg",
    "customLogoDark": "./brand/cngx-lockup-full-on-dark.svg",
    "shikiTheme": "github-light:github-dark",
    "includes": "core-concepts",
    "includesName": "Core Concepts",
    "aiGeneratedNote": "Drafted with AI assistance ({value}) and reviewed by a maintainer.",
    "disableMarkdownPages": ["changelog", "license"],
    "exampleUrlBase": "https://cngxjs.github.io/cngx/examples",
    "assetsFolder": "brand",
    "disableSourceCode": true,
    "disableTemplateTab": true,
    "disableStyleTab": true,
    "disablePrivate": true,
    "disableInternal": true,
    "disableRoutes": true,
    "disableDomTree": true,
    "disableGraph": false,
    "disableDependenciesTab": true,
    "disableDependencies": true,
    "disableProperties": true,
    "menuLayout": "feature",
    "featuresName": "Libraries",
    "features": {
        "projects/common/display/tag/config/**": "tag-config",
        "projects/common/display/tag/slots/**": "tag-slots",
        "projects/common/display/tag-group/slots/**": "tag-group-slots",
        "projects/common/stepper/slots/**": "slots",
        "projects/common/chart/axis/**": "axis",
        "projects/common/chart/chart/**": "chart",
        "projects/common/chart/layers/**": "layers",
        "projects/common/chart/legend/**": "legend",
        "projects/common/chart/path/**": "path",
        "projects/common/chart/presets/**": "presets",
        "projects/common/chart/scales/**": "scales",
        "projects/common/data/async-state/**": "async-state",
        "projects/common/data/display/metric/**": "metric",
        "projects/common/data/display/trend/**": "trend",
        "projects/common/dialog/bottom-sheet/**": "bottom-sheet",
        "projects/common/dialog/dialog/**": "dialog",
        "projects/common/dialog/draggable/**": "draggable",
        "projects/common/display/tag-group/**": "tag-group",
        "projects/common/interactive/control-value/**": "control-value",
        "projects/common/interactive/error-registry/**": "error-registry",
        "projects/common/interactive/error-scope/**": "error-scope",
        "projects/common/interactive/tree-controller/**": "tree-controller",
        "projects/forms/select/action-multi-select/**": "action-multi-select",
        "projects/forms/select/action-select/**": "action-select",
        "projects/forms/select/combobox/**": "combobox",
        "projects/forms/select/declarative/**": "declarative",
        "projects/forms/select/multi-select/**": "multi-select",
        "projects/forms/select/reorderable-multi-select/**": "reorderable-multi-select",
        "projects/forms/select/select-shell/**": "select-shell",
        "projects/forms/select/single-select/**": "single-select",
        "projects/forms/select/tree-select/**": "tree-select",
        "projects/forms/select/typeahead/**": "typeahead",
        "projects/ui/feedback/banner/**": "banner",
        "projects/ui/feedback/config/**": "config",
        "projects/ui/feedback/toast/**": "toast",
        "projects/ui/mat-stepper/material-bridge/**": "material-bridge",
        "projects/ui/mat-tabs/decorations/**": "decorations",
        "projects/ui/mat-tabs/material-bridge/**": "material-bridge",
        "projects/ui/mat-tabs/overflow/**": "overflow"
    },
    "collapsedAll": true,
    "classificationAxes": {
        "level": {
            "label": "Level",
            "values": [
                "atom",
                "molecule",
                "organism"
            ],
            "kinds": [
                "component",
                "directive"
            ]
        }
    },
    "showEffects": false,
    "apiTabSections": [
        "index",
        "inputs",
        "outputs",
        "properties",
        "methods",
        "accessors",
        "indexSignatures",
        "hostBindings",
        "hostListeners"
    ],
    "styleFiles": [
        "projects/*/theming/**/*.css",
        "projects/themes/*.css",
        "projects/themes/material/{*theme,*-bridge}.scss"
    ],
    "themingTabSections": [
        "overview",
        "index",
        "tokens",
        "mixins"
    ],
    "navTabConfig": [
        {
            "id": "readme",
            "label": "UX / A11Y Principles"
        },
        {
            "id": "info",
            "label": "Info"
        },
        {
            "id": "api",
            "label": "API"
        },
        {
            "id": "theming",
            "label": "Theming"
        },
        {
            "id": "example",
            "label": "Example"
        },
        {
            "id": "playground",
            "label": "Playground"
        }
    ],
    "playgroundDependencies": {
        "@cngx/utils": "0.1.0-rc.9",
        "@cngx/core": "0.1.0-rc.9",
        "@cngx/common": "0.1.0-rc.9",
        "@cngx/forms": "0.1.0-rc.9",
        "@cngx/ui": "0.1.0-rc.9",
        "@cngx/data-display": "0.1.0-rc.9",
        "@cngx/interop": "0.1.0-rc.9",
        "@cngx/themes": "0.1.0-rc.9",
        "@angular/material": "^21.2.14",
        "libphonenumber-js": "^1.11.0"
    },
    "playgroundGlobalStyles": "@import '@cngx/themes/cngx.css';",
    "playgroundMaterialShell": true
}