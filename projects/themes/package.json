{
  "name": "@cngx/themes",
  "version": "0.0.0-PLACEHOLDER",
  "description": "Single-import default theme and example brand theme for the CNGX Angular component library.",
  "keywords": [
    "cngx",
    "angular",
    "theme",
    "css",
    "tokens",
    "cascade-layers"
  ],
  "author": "Christian Weiss <info@cngx.dev>",
  "license": "MIT",
  "homepage": "https://github.com/cngxjs/cngx#readme",
  "bugs": {
    "url": "https://github.com/cngxjs/cngx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cngxjs/cngx.git",
    "directory": "projects/themes"
  },
  "peerDependencies": {
    "@cngx/core": "0.0.0-PLACEHOLDER",
    "@cngx/common": "0.0.0-PLACEHOLDER",
    "@cngx/forms": "0.0.0-PLACEHOLDER",
    "@cngx/ui": "0.0.0-PLACEHOLDER",
    "@cngx/data-display": "0.0.0-PLACEHOLDER",
    "@angular/material": ">=21.1.0 <23.0.0",
    "@angular/cdk": ">=21.1.0 <23.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/material": {
      "optional": true
    },
    "@angular/cdk": {
      "optional": true
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./cngx.css": "./cngx.css",
    "./example-brand.css": "./example-brand.css",
    "./material/*": "./material/*.scss",
    "./material/*.scss": "./material/*.scss"
  },
  "schematics": "./schematics/collection.json",
  "ng-update": {
    "packageGroup": [
      "@cngx/utils",
      "@cngx/core",
      "@cngx/common",
      "@cngx/interop",
      "@cngx/forms",
      "@cngx/data-display",
      "@cngx/ui",
      "@cngx/themes"
    ]
  }
}
