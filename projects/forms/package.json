{
  "name": "@cngx/forms",
  "version": "0.0.0-PLACEHOLDER",
  "description": "Forms-related organisms (controls, validators, field bridge, select family) for the CNGX Angular component library. Signal-Forms first.",
  "keywords": [
    "cngx",
    "angular",
    "signals",
    "forms",
    "signal-forms",
    "select",
    "combobox",
    "typeahead"
  ],
  "author": "Christian Weiss <info@cngx.dev>",
  "license": "MIT",
  "homepage": "https://github.com/cngxjs/cngx#readme",
  "bugs": {
    "url": "https://github.com/cngxjs/cngx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cngxjs/cngx.git",
    "directory": "projects/forms"
  },
  "peerDependencies": {
    "@cngx/utils": "0.0.0-PLACEHOLDER",
    "@cngx/core": "0.0.0-PLACEHOLDER",
    "@cngx/common": "0.0.0-PLACEHOLDER",
    "@angular/common": ">=21.1.0 <23.0.0",
    "@angular/core": ">=21.1.0 <23.0.0",
    "@angular/forms": ">=21.1.0 <23.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "exports": {
    "./theming/*.css": "./theming/*.css"
  },
  "schematics": "./schematics/collection.json",
  "ng-update": {
    "packageGroup": [
      "@cngx/utils",
      "@cngx/core",
      "@cngx/common",
      "@cngx/interop",
      "@cngx/forms",
      "@cngx/data-display",
      "@cngx/ui",
      "@cngx/themes"
    ]
  }
}
