{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cngxjs/cngx/blob/main/scripts/manifests/error-codes.schema.json",
  "title": "cngx error-code manifest",
  "description": "Every coded dev diagnostic the cngx libs emit through cngxDevWarn / cngxDevError, generated by scripts/error-codes-manifest.mjs from the call sites and the pages under core-concepts/error-codes/. Bump schemaVersion here and in the generator on any shape change.",
  "type": "object",
  "required": ["$schema", "schemaVersion", "docsBaseUrl", "ranges", "codes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "docsBaseUrl": {
      "type": "string",
      "description": "Base URL of the code pages; a page is <docsBaseUrl>cngx<nnnn>.html."
    },
    "ranges": { "type": "array", "items": { "$ref": "#/$defs/range" } },
    "codes": { "type": "array", "items": { "$ref": "#/$defs/code" } }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["lib", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "lib": { "type": "string", "description": "The lib that emits codes in this range." },
        "from": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "to": { "type": "integer", "minimum": 1, "maximum": 9999 }
      }
    },
    "code": {
      "type": "object",
      "required": ["code", "lib", "severity", "title", "page", "url", "status", "files"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^CNGX\\d{4}$" },
        "lib": { "type": ["string", "null"], "description": "The lib whose range holds the code." },
        "severity": {
          "enum": ["warn", "error", null],
          "description": "The console channel; null for a retired code."
        },
        "title": { "type": ["string", "null"], "description": "The page's H2." },
        "page": { "type": "string", "description": "Repo-relative path of the doc page." },
        "url": { "type": "string", "description": "The published doc page." },
        "status": { "enum": ["active", "retired"] },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Repo-relative source files that emit the code; empty when retired."
        }
      }
    }
  }
}
