{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cngxjs/cngx/blob/main/scripts/manifests/copy-cascades.schema.json",
  "title": "cngx copy-cascade manifest",
  "description": "Every input-over-bundle copy cascade in the cngx libs, generated by scripts/copy-cascade-manifest.mjs. Bump schemaVersion here and in the generator on any shape change.",
  "type": "object",
  "required": ["$schema", "schemaVersion", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["class", "file", "line", "member", "enclosing"],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": ["string", "null"],
          "description": "The class holding the chain; null inside a plain function."
        },
        "file": { "type": "string", "description": "Repo-relative source path." },
        "line": { "type": "integer", "minimum": 1 },
        "member": {
          "type": "string",
          "description": "The class member, or <function>.<local> outside a class."
        },
        "enclosing": {
          "enum": ["computed", "method", "effect", "untracked", "function"],
          "description": "Where the chain is evaluated."
        },
        "tiers": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/tier" },
          "description": "Operands in resolution order: the first defined one wins."
        },
        "unresolved": {
          "type": "string",
          "description": "Why the generator could not classify every operand."
        }
      },
      "oneOf": [{ "required": ["tiers"] }, { "required": ["unresolved"] }]
    },
    "tier": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "field"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "input" },
            "field": { "type": "string", "description": "The input() / model() signal read." }
          }
        },
        {
          "type": "object",
          "required": ["kind", "field", "path", "token"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["bundle", "bundle-fn", "bundle-signal"] },
            "field": {
              "type": "string",
              "description": "The member or local the read starts from."
            },
            "path": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Key path below the field; empty for bundle-signal."
            },
            "token": { "type": "string", "description": "The copy token the bundle comes from." }
          }
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "literal" },
            "value": { "type": ["string", "null"] }
          }
        }
      ]
    }
  }
}
