{
  "name": "@cngx/eslint-plugin",
  "version": "0.2.0",
  "description": "ESLint rules that encode the cngx signal/effect idioms and wiring contracts for consumer Angular apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cngxjs/cngx.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://cngxjs.github.io/cngx",
  "bugs": "https://github.com/cngxjs/cngx/issues",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "@angular-eslint/template-parser": ">=19"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.56.1"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^21.3.0",
    "@typescript-eslint/rule-tester": "^8.56.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "angular",
    "signals",
    "cngx"
  ],
  "publishConfig": {
    "access": "public"
  }
}
